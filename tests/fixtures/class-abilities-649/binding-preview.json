{
  "entries": [
    {
      "externalKey": "pf1/xxD5AbgfJ5OuzVld",
      "upstreamKey": "pf1/xxD5AbgfJ5OuzVld",
      "pack": "class-abilities",
      "name": "Bloodline Feat (BLO)",
      "detail": {
        "kind": "classFeature"
      },
      "description": "<p>At 6th level and every 3 levels thereafter, a bloodrager receives one bonus feat chosen from a list specific to each bloodline. The bloodrager must meet the prerequisites for these bonus feats.</p>",
      "sources": [
        {
          "book": "PZO1129",
          "pages": "15"
        }
      ],
      "modifiers": [],
      "unsupported": [
        {
          "field": "gameContent",
          "reason": "Source game-content fields retained for feature curation; only explicitly mapped detail/modifiers have an interpretation.",
          "value": {
            "associations": {
              "classes": ["Bloodrager"]
            }
          }
        },
        {
          "field": "changes",
          "reason": "Unmapped target, bonus type, formula or calculation-stage dependency; contributes nothing.",
          "value": {
            "target": "bonusFeats",
            "formula": "floor(@class.level / 3) - 1",
            "type": "untyped"
          }
        }
      ]
    },
    {
      "externalKey": "pf1/yotHT522pQoKDhID",
      "upstreamKey": "pf1/yotHT522pQoKDhID",
      "pack": "class-abilities",
      "name": "Slayer's Advance",
      "detail": {
        "kind": "classFeature"
      },
      "description": "<p>At 13th level, a slayer can once per day move up to twice his base speed as a move action. He may use Stealth as part of this movement, but takes a –10 penalty to his check for doing so.</p>\n<p>At 17th level, he can do this twice per day.</p>",
      "sources": [
        {
          "book": "PZO1129",
          "pages": "55"
        }
      ],
      "modifiers": [],
      "unsupported": [
        {
          "field": "gameContent",
          "reason": "Source game-content fields retained for feature curation; only explicitly mapped detail/modifiers have an interpretation.",
          "value": {
            "actions": [
              {
                "_id": "actgemorp4k431a4",
                "activation": {
                  "type": "move",
                  "unchained": {
                    "type": "action"
                  }
                },
                "name": "Use"
              }
            ],
            "associations": {
              "classes": ["Slayer"]
            },
            "uses": {
              "maxFormula": "1 + if(gte(@class.level, 17), 1)",
              "per": "day"
            }
          }
        }
      ]
    }
  ],
  "closure": [],
