  "entries": [
    {
      "externalKey": "pf1/NsP31IshAuY4gv0s",
      "upstreamKey": "pf1/NsP31IshAuY4gv0s",
      "pack": "class-abilities",
      "name": "Ki powers (UC)",
      "detail": {
        "kind": "classFeature"
      },
      "description": "<p>At 4th level and every 2 levels thereafter, a monk can select one ki power. These powers allow the monk to perform amazing feats of mystical power and acrobatic prowess by expending points from his ki pool. Once a ki power is selected, it cannot be changed. Some ki powers require the monk to be of a specific level or higher before they can be chosen.</p>\n<p>Unless otherwise noted, a monk cannot select an individual ki power more than once.</p>",
      "sources": [
        {
          "book": "PZO1131",
          "pages": "16"
        }
      ],
      "modifiers": [],
      "unsupported": [
        {
          "field": "gameContent",
          "reason": "Source game-content fields retained for feature curation; only explicitly mapped detail/modifiers have an interpretation.",
          "value": {
            "associations": {
              "classes": ["Monk (Unchained)"]
            }
          }
        }
      ]
    }
  ],
