      "pack": "monster-abilities",
      "name": "Unarmed Strike",
      "detail": {
        "kind": "item",
        "consumable": false,
        "price": 0,
        "weight": 0,
        "weapon": {
          "baseTypes": ["Unarmed Strike"],
          "groups": ["close", "monk", "natural", "tribal"],
          "proficiency": "always",
          "handedness": "light",
          "dice": "1d3",
          "damageTypes": ["bludgeoning"],
          "threat": 20,
          "mult": 2,
          "finesse": false,
          "thrown": false
        }
      },
      "description": "<p>The damage from an unarmed strike is considered weapon damage for the purposes of effects that give you a bonus on weapon damage rolls.</p><p>An unarmed strike is always considered a light weapon. Therefore, you can use the Weapon Finesse feat to apply your Dexterity modifier instead of your Strength modifier to attack rolls with an unarmed strike.</p><p>Unarmed strikes do not count as natural weapons (see Combat in core rulebook).</p>",
      "sources": [
        {
          "book": "PZO1110",
          "pages": "142, 149"
        }
      ],
      "modifiers": [],
      "unsupported": [
        {
          "field": "gameContent",
          "reason": "Source game-content fields retained for feature curation; only explicitly mapped detail/modifiers have an interpretation.",
          "value": {
            "actions": [
              {
                "_id": "h1prw1ahiomk0bs5",
                "ability": {
                  "attack": "str",
                  "damage": "str",
                  "damageMult": 1
                },
                "actionType": "mwak",
                "activation": {
                  "type": "attack",
                  "unchained": {
                    "type": "attack"
                  }
                },
                "damage": {
                  "parts": [
                    {
                      "formula": "sizeRoll(1, 3, @size)",
                      "types": ["bludgeoning"]
                    }
                  ]
                },
                "name": "Attack",
                "nonlethal": true,
                "range": {
                  "units": "melee"
                },
                "tag": "unarmedStrike"
              }
            ]
          }
        }
      ],
      "situationalNotes": [
        {
          "target": "damage",
          "text": "The damage from an unarmed strike is considered weapon damage for the purposes of effects that give you a bonus on weapon damage rolls."
        },
        {
          "target": "attack",
          "text": "Unarmed strikes do not count as natural weapons (see Combat in core rulebook)."
        }
      ]
    },
