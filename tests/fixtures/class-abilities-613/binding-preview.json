{
  "entries": [
    {
      "externalKey": "pf1/CK5L0YJDENqBxLqv",
      "upstreamKey": "pf1/CK5L0YJDENqBxLqv",
      "pack": "class-abilities",
      "name": "Fast Movement (MNK)",
      "detail": {
        "kind": "classFeature"
      },
      "description": "<p>At 3rd level, a monk gains an <em>enhancement bonus</em> to his land speed, as seen below. A monk in armor or carrying a medium or heavy load loses this extra speed.</p><table><thead><tr><th>Starting Level</th><th>Bonus Speed</th></tr></thead><tbody><tr><td>3</td><td>+10 ft.</td></tr><tr><td>6</td><td>+20 ft.</td></tr><tr><td>9</td><td>+30 ft.</td></tr><tr><td>12</td><td>+40 ft.</td></tr><tr><td>15</td><td>+50 ft.</td></tr><tr><td>18</td><td>+60 ft.</td></tr></tbody></table>",
      "sources": [
        {
          "book": "PZO1110",
          "pages": "59"
        },
        {
          "book": "PZO1131",
          "pages": "15"
        }
      ],
      "modifiers": [],
      "unsupported": [
        {
          "field": "gameContent",
          "reason": "Source game-content fields retained for feature curation; only explicitly mapped detail/modifiers have an interpretation.",
          "value": {
            "associations": {
              "classes": ["Monk", "Monk (Unchained)"]
            }
          }
        },
        {
          "field": "changes",
          "reason": "Unmapped target, bonus type, formula or calculation-stage dependency; contributes nothing.",
          "value": {
            "target": "landSpeed",
            "formula": "10 * (floor(@class.level / 3))",
            "type": "enh"
          }
        }
      ]
    }
  ],
  "closure": [],
