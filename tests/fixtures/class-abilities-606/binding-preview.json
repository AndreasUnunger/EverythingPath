{
  "entries": [
    {
      "externalKey": "pf1/2qcz39w9O2Qlms0Q",
      "upstreamKey": "pf1/2qcz39w9O2Qlms0Q",
      "pack": "class-abilities",
      "name": "Poison Resistance",
      "detail": {
        "kind": "classFeature"
      },
      "description": "<p>At 2nd level, the character gains a +2 bonus on all saving throws against poison. This bonus increases to +4 at 5th level, and then again to +6 at 8th level.</p>",
      "sources": [
        {
          "book": "PZO1115",
          "pages": "31"
        },
        {
          "book": "PZO1129",
          "pages": "31"
        }
      ],
      "modifiers": [
        {
          "target": "saves",
          "bonusType": "untyped",
          "value": {
            "formula": "min(6, floor((max(@classLevel.alchemist, @classLevel.investigator) + 1) / 3) * 2)"
          },
          "condition": {
            "situation": "poison"
          }
        }
      ],
      "unsupported": [
        {
          "field": "gameContent",
          "reason": "Source game-content fields retained for feature curation; only explicitly mapped detail/modifiers have an interpretation.",
          "value": {
            "associations": {
              "classes": ["Alchemist", "Investigator"]
            }
          }
        }
      ]
    }
  ],
