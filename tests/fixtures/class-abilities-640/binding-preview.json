      "pack": "class-abilities",
      "name": "Lore Master",
      "detail": {
        "kind": "classFeature"
      },
      "description": "<p>At 5th level, the bard becomes a master of lore and can take 10 on any <em>Knowledge</em> skill check that he has ranks in. A bard can choose not to take 10 and can instead roll normally. In addition, once per day, the bard can take 20 on any <em>Knowledge</em> skill check as a <em>standard action</em>. He can use this ability one additional time per day for every six levels he possesses beyond 5th, to a maximum of three times per day at 17th level.</p>",
      "sources": [
        {
          "book": "PZO1110",
          "pages": "38"
        }
      ],
      "modifiers": [],
      "unsupported": [
        {
          "field": "gameContent",
          "reason": "Source game-content fields retained for feature curation; only explicitly mapped detail/modifiers have an interpretation.",
          "value": {
            "actions": [
              {
                "_id": "vdpeu8pfvgw0werj",
                "activation": {
                  "type": "standard",
                  "unchained": {
                    "cost": 2,
                    "type": "action"
                  }
                },
                "name": "Take 20"
              }
            ],
            "associations": {
              "classes": ["Bard"]
            },
            "uses": {
              "maxFormula": "floor((@class.level + 1) / 6)",
              "per": "day"
            }
          }
        }
      ]
    }
  ],
