{
  "name": "everythingpath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:web",
    "build:web": "next build",
    "check": "pnpm lint && pnpm typecheck",
    "check:convex-generated": "bash scripts/check-convex-generated.sh",
    "dev": "bash scripts/dev.sh",
    "dev:web": "next dev --turbopack",
    "dev:convex": "CONVEX_DEPLOY_KEY= CONVEX_DEPLOYMENT_TOKEN= convex dev",
    "deploy:convex": "bash scripts/deploy-convex.sh",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "pnpm -s lint:eslint && pnpm -s lint:unused",
    "lint:fix": "pnpm -s lint:eslint --fix && pnpm -s lint:unused",
    "preview": "next build && next start",
    "start": "next start",
    "test": "NODE_OPTIONS='--experimental-require-module --no-warnings' vitest run",
    "test:build": "node --test scripts/build-boundary.test.mjs",
    "test:e2e": "tsx e2e/run.ts",
    "e2e:provision": "tsx e2e/provision.ts",
    "test:watch": "NODE_OPTIONS='--experimental-require-module --no-warnings' vitest",
    "typecheck": "tsc --noEmit && tsc -p convex/tsconfig.json --noEmit",
    "rules:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-rules-coverage.ts",
    "rules:complete": "pnpm -s rules:check --strict",
    "acceptance:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-acceptance.ts",
    "lint:eslint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js .",
    "lint:unused": "knip",
    "catalog:preview": "node --import tsx scripts/catalog-preview.ts",
    "catalog:curate": "node --import tsx scripts/catalog-curate.ts",
    "check:initial-migration-writers": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-initial-migration-writers.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.37.3",
    "@clerk/themes": "^2.4.51",
    "@convex-dev/aggregate": "^0.2.1",
    "@convex-dev/react-query": "^0.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.90.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "convex-helpers": "^0.1.124",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "svix": "^1.84.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.33",
    "@convex-dev/eslint-plugin": "^1.1.1",
    "@edge-runtime/vm": "^5.0.0",
    "@next/eslint-plugin-next": "16.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "convex-test": "^0.0.50",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fflate": "^0.8.3",
    "jsdom": "^28.1.0",
    "knip": "^6.39.0",
    "parse5": "8.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "7.3.1",
    "vitest": "^4.0.18",
    "yaml": "2.9.1"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "pnpm@10.29.1",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.0",
      "@types/react-dom": "19.2.0"
    },
    "patchedDependencies": {
      "@convex-dev/react-query@0.1.0": "patches/@convex-dev__react-query@0.1.0.patch"
    }
  }
}
