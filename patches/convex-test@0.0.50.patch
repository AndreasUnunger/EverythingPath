+// Whether `validateValidator` accepts `value`, without throwing. Union members
+// are tried with this, because an Error per rejected member captures a stack
+// trace, which made validating large union-typed documents slow.
+// It mirrors `validateValidator` case by case: when upgrading convex-test,
+// carry any change to one into the other. A validator type it does not know
+// (such as `record`) falls back to `validateValidator` itself.
+function matchesValidator(validator, value) {
+    switch (validator.type) {
+        case "null":
+            return value === null;
+        case "number":
+            return typeof value === "number";
+        case "bigint":
+            return typeof value === "bigint";
+        case "boolean":
+            return typeof value === "boolean";
+        case "string":
+            return typeof value === "string";
+        case "bytes":
+            return value instanceof ArrayBuffer;
+        case "any":
+            return true;
+        case "literal":
+            return value === validator.value;
+        case "id":
+            return (typeof value === "string" &&
+                tableNameFromId(value) === validator.tableName);
+        case "array": {
+            if (!Array.isArray(value)) {
+                return false;
+            }
+            for (const v of value) {
+                if (!matchesValidator(validator.value, v)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        case "union":
+            return validator.value.some((v) => matchesValidator(v, value));
+        case "object": {
+            if (typeof value !== "object" ||
+                value === null ||
+                !isSimpleObject(value)) {
+                return false;
+            }
+            for (const [k, { fieldType, optional }] of Object.entries(validator.value)) {
+                if (value[k] === undefined) {
+                    if (!optional) {
+                        return false;
+                    }
+                }
+                else if (!matchesValidator(fieldType, value[k])) {
+                    return false;
+                }
+            }
+            for (const k of Object.keys(value)) {
+                if (validator.value[k] === undefined) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        default:
+            try {
+                validateValidator(validator, value);
+                return true;
+            }
+            catch {
+                return false;
+            }
+    }
